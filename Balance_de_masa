import numpy as np

# ---------------- DATOS ----------------
matriz_estatica = np.array([
    [1.0,  1.0,  1.0],   # Suma de fuerzas Z
    [0.0,  1.5, -1.5],   # Momentos en X
    [-2.0, 1.0,  1.0]    # Momentos en Y
])
vector_cargas = np.array([25000.0, 1500.0, -800.0])  # [N, Nm, Nm]

def _gauss_jordan_recursivo(M, k=0):
    """
    Gauss-Jordan con pivoteo parcial, sin bucles (recursion).
    M: matriz aumentada [A | b] (n x n+1). k: columna pivote actual.
    """
    n = M.shape[0]
    if k == n:                                   # caso base
        return M

    # Pivoteo parcial: fila con mayor |valor| en la columna k (de k hacia abajo)
    p = k + np.argmax(np.abs(M[k:, k]))
    if np.isclose(M[p, k], 0.0):
        raise ValueError("Matriz singular: el sistema no tiene solucion unica.")

    M = M.copy()
    M[[k, p]] = M[[p, k]]                        # intercambio de filas
    M[k] = M[k] / M[k, k]                        # pivote = 1

    # Anular la columna k en TODAS las demas filas de golpe
    factores = M[:, k].copy()
    factores[k] = 0.0                            # la fila pivote no se toca
    M = M - np.outer(factores, M[k])             # F_i <- F_i - f_i * F_pivote

    return _gauss_jordan_recursivo(M, k + 1)


def resolver_sistema(A, b):
    """Resuelve A x = b. Devuelve x."""
    A = np.asarray(A, dtype=float)
    b = np.asarray(b, dtype=float)
    M = np.hstack((A, b.reshape(-1, 1)))         # matriz aumentada [A | b]
    return _gauss_jordan_recursivo(M)[:, -1]     # [I | x] -> ultima columna


